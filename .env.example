# Server port
PORT=3001

# Anthropic API key (server-side only, never exposed to the browser)
ANTHROPIC_API_KEY=your-api-key-here

# Model used for AI features (dependency suggestions, impact investigator, drift detector)
ANTHROPIC_MODEL=claude-sonnet-4-6

# SQLite DB file path (gitignored, created on first run)
DATABASE_PATH=./server/data/taskflow.db
