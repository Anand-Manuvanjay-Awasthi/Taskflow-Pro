# Spring Boot server port
PORT=3001

# Anthropic is optional. Keys are read server-side only and are never returned by the API.
ANTHROPIC_API_KEY=your-api-key-here
ANTHROPIC_MODEL=claude-sonnet-4-6

# Optional SQLite JDBC URL override. The default is jdbc:sqlite:./data/taskflow.db
# DATABASE_URL=jdbc:sqlite:./data/taskflow.db
